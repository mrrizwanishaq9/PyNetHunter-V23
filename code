# ============================================================
# SHA-256
# ============================================================

def sha256_tool():

    header("SHA-256 HASH GENERATOR")

    text = input("Enter text: ")

    result = hashlib.sha256(
        text.encode("utf-8")
    ).hexdigest()

    print()
    print(GREEN + "SHA-256:" + RESET)
    print(result)

    pause()


# ============================================================
# FILE HASH
# ============================================================

def file_hash():

    header("FILE SHA-256 CHECKER")

    path = input("Enter file path: ").strip().strip('"')

    if not os.path.isfile(path):

        print(
            RED
            + "\nFile not found."
            + RESET
        )

        pause()
        return

    sha = hashlib.sha256()

    try:

        with open(path, "rb") as file:

            while True:

                chunk = file.read(1024 * 1024)

                if not chunk:
                    break

                sha.update(chunk)

        print()
        print(GREEN + "SHA-256:" + RESET)
        print(sha.hexdigest())

    except Exception as error:

        print(
            RED
            + "\nError: "
            + RESET
            + str(error)
        )

    pause()


