def system_info():

    header("SYSTEM INFORMATION")

    print(f"{GREEN}Operating System:{RESET} {platform.system()}")
    print(f"{GREEN}OS Version      :{RESET} {platform.release()}")
    print(f"{GREEN}Architecture    :{RESET} {platform.machine()}")
